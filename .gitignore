# Local .terraform directories
**/.terraform/*

# Terraform lock file — uncomment if you want to ignore it (not recommended)
# .terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Terraform variable files (may contain secrets)
*.tfvars
*.tfvars.json

# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output
*.tfplan

# Terraform CLI configuration
.terraformrc
terraform.rc

# macOS
.DS_Store

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo
